e":0},"directionFix":false,"image":{"characterIndex":0,"characterName":"","direction":2,"pattern":0,"tileId":0},"list":[{"code":101,"indent":0,"parameters":["蛋蛋 頭像",0,0,2,"豬腳"]},{"code":401,"indent":0,"parameters":["該怎麼打敗蚩尤?"]},{"code":101,"indent":0,"parameters":["黃帝 頭像",0,0,2,"黃帝"]},{"code":401,"indent":0,"parameters":["......"]},{"code":101,"indent":0,"parameters":["黃帝 頭像",0,0,2,"黃帝"]},{"code":401,"indent":0,"parameters":["你怎麼會問這種問題。"]},{"code":101,"indent":0,"parameters":["蛋蛋 頭像",0,0,2,"豬腳"]},{"code":401,"indent":0,"parameters":["嗯...說來話長，我長話短說吧，我遇到他了。"]},{"code":101,"indent":0,"parameters":["黃帝 頭像",0,0,2,"黃帝"]},{"code":401,"indent":0,"parameters":["在哪裡!!!"]},{"code":101,"indent":0,"parameters":["蛋蛋 頭像",0,0,2,"豬腳"]},{"code":401,"indent":0,"parameters":["我偶然去到的其他地方"]},{"code":101,"indent":0,"parameters":["黃帝 頭像",0,0,2,"黃帝"]},{"code":401,"indent":0,"parameters":["我跟你說，他的能力並非我們世界的力量，必須小心，"]},{"code":401,"indent":0,"parameters":["那力量非同小可，我都無法匹敵。"]},{"code":101,"indent":0,"parameters":["黃帝 頭像",0,0,2,"黃帝"]},{"code":401,"indent":0,"parameters":["首先是他周圍的瘴氣。氣味惡臭，吸上一口就會有火"]},{"code":401,"indent":0,"parameters":["辣辣的灼燒感，導致你意識混亂、眼神渙散。"]},{"code":101,"indent":0,"parameters":["黃帝 頭像",0,0,2,"黃帝"]},{"code":401,"indent":0,"parameters":["你若想與他對抗，必須先克服此問題。這個能力是來"]},{"code":401,"indent":0,"parameters":["自於他請來的盟友—— 風伯及雨師。"]},{"code":101,"indent":0,"parameters":["黃帝 頭像",0,0,2,"黃帝"]},{"code":401,"indent":0,"parameters":["這兩人是天上之人，非我等能對抗的，只能找與他們"]},{"code":401,"indent":0,"parameters":["同級別的幫手來對抗，我當時找的是應龍與女魃，"]},{"code":401,"indent":0,"parameters":["才勉強壓制住瘴氣的干擾。"]},{"code":101,"indent":0,"parameters":["黃帝 頭像",0,0,2,"黃帝"]},{"code":401,"indent":0,"parameters":["不過根據你說的情況，那個世界風伯雨師應該不會在，"]},{"code":401,"indent":0,"parameters":["那個瘴氣應該會是他自己所製造出來的次品，"]},{"code":401,"indent":0,"parameters":["雖然沒有風伯雨師那麼厲害，不過也是傷害極大。"]},{"code":101,"indent":0,"parameters":["黃帝 頭像",0,0,2,"黃帝"]},{"code":401,"indent":0,"parameters":["你能夠做的大概也就兩件事情：一是摀住口鼻，"]},{"code":401,"indent":0,"parameters":["準備好恢復體力的食物與藥品，一步一步的走向蚩尤，"]},{"code":401,"indent":0,"parameters":["直接與他對打，把他擊敗後瘴氣自會消散。"]},{"code":101,"indent":0,"parameters":["黃帝 頭像",0,0,2,"黃帝"]},{"code":401,"indent":0,"parameters":["二是把他用能力複製的瘴氣製造者擊敗，也許是陣法，"]},{"code":401,"indent":0,"parameters":["也許是許多人，我不確定，但先把他們擊敗消散瘴氣"]},{"code":401,"indent":0,"parameters":["與蚩尤的戰鬥將會輕鬆許多。"]},{"code":101,"indent":0,"parameters":["黃帝 頭像",0,0,2,"黃帝"]},{"code":401,"indent":0,"parameters":["其次是他的兵器，他本身是一個極具天賦的鍛造師，"]},{"code":401,"indent":0,"parameters":["打造出了許多厲害精緻的兵器鎧甲，你與他戰鬥時務"]},{"code":401,"indent":0,"parameters":["必小心，他有幾樣常用的武器：弓、矛、戟、鎧、劍。"]},{"code":101,"indent":0,"parameters":["黃帝 頭像",0,0,2,"黃帝"]},{"code":401,"indent":0,"parameters":["勁弓在他手裡箭無虛發，且每發箭矢皆具有萬鈞之力，"]},{"code":401,"indent":0,"parameters":["能輕易將金屬射穿，他曾經在戰場上一次性貫穿了五"]},{"code":401,"indent":0,"parameters":["名我軍士兵的頭顱，戰鬥時務必小心他的舉弓動作。"]},{"code":101,"indent":0,"parameters":["黃帝 頭像",0,0,2,"黃帝"]},{"code":401,"indent":0,"parameters":["長矛對他來說近可用來突刺將敵人開膛破肚，遠可投"]},{"code":401,"indent":0,"parameters":["擲將敵人貫穿，有時甚至還可以當作棍來耍，靈活性"]},{"code":401,"indent":0,"parameters":["極高，只能見招拆招了。"]},{"code":101,"indent":0,"parameters":["黃帝 頭像",0,0,2,"黃帝"]},{"code":401,"indent":0,"parameters":["重戟在他手裡耍的虎虎生風，雖說是重戟，但對於他"]},{"code":401,"indent":0,"parameters":["你幾乎看不到這個武器的笨重，上挑、下劈、橫掃，"]},{"code":401,"indent":0,"parameters":["動作連貫幾乎沒有喘息時間，更恐怖的是此武器的質"]},{"code":401,"indent":0,"parameters":["量大，幾乎一碰就死，如果遇到了，盡速遠離。"]},{"code":101,"indent":0,"parameters":["黃帝 頭像",0,0,2,"黃帝"]},{"code":401,"indent":0,"parameters":["堅鎧是他幾樣武器中唯一的防禦手段，但搭配上他的"]},{"code":401,"indent":0,"parameters":["肉體強度，幾乎極難突破，皮膚硬得像石頭，只要沒"]},{"code":401,"indent":0,"parameters":["有利用技巧以柔克剛或是你武器沒有比他的鎧甲堅硬，"]},{"code":401,"indent":0,"parameters":["你就幾乎不可能讓他受傷。"]},{"code":101,"indent":0,"parameters":["黃帝 頭像",0,0,2,"黃帝"]},{"code":401,"indent":0,"parameters":["你絕對不要跟他硬碰硬，要趁他出力後順著他力的方"]},{"code":401,"indent":0,"parameters":["向，施以同樣方向的力使他的攻擊偏移露出破綻，"]},{"code":401,"indent":0,"parameters":["之後找機會攻擊他皮膚最薄弱的地方，像是他的關節、"]},{"code":401,"indent":0,"parameters":["上三路或是下三路。"]},{"code":101,"indent":0,"parameters":["黃帝 頭像",0,0,2,"黃帝"]},{"code":401,"indent":0,"parameters":["鋒劍，這個最令人絕望。他的劍並不可怕，沒有前面"]},{"code":401,"indent":0,"parameters":["幾項有壓迫力或是有殺傷力，但是最恐怖的是這可以"]},{"code":401,"indent":0,"parameters":["掌控所有人的劍，士兵手上的、城市裡的，只要是劍"]},{"code":401,"indent":0,"parameters":["都會被他立刻奪走控制權。"]},{"code":101,"indent":0,"parameters":["黃帝 頭像",0,0,2,"黃帝"]},{"code":401,"indent":0,"parameters":["你知道有多絕望嗎，他可以使用他鍛造的鋒劍瞬間奪"]},{"code":401,"indent":0,"parameters":["走任何人手上的劍，隨時！而且還不止一把，他身後"]},{"code":401,"indent":0,"parameters":["有數以萬計的利劍，伸手一揮，瞬間劍如雨下，"]},{"code":401,"indent":0,"parameters":["密密麻麻的利劍壟罩著我們。"]},{"code":101,"indent":0,"parameters":["黃帝 頭像",0,0,2,"黃帝"]},{"code":401,"indent":0,"parameters":["看到他使出此招，別想著躲了，保護好頭部身體扛下"]},{"code":401,"indent":0,"parameters":["來吧，然後準備好藥品治療傷勢。"]},{"code":101,"indent":0,"parameters":["黃帝 頭像",0,0,2,"黃帝"]},{"code":401,"indent":0,"parameters":["最後是他的新力量—— 渾沌，但很可惜我也知之甚少，"]},{"code":401,"indent":0,"parameters":["我也並未深度了解。"]},{"code":101,"indent":0,"parameters":["蛋蛋 頭像",0,0,2,"豬腳"]},{"code":401,"indent":0,"parameters":["謝謝提醒。"]},{"code":111,"indent":0,"parameters":[8,52]},{"code":0,"indent":1,"parameters":[]},{"code":411,"indent":0,"parameters":[]},{"code":126,"indent":1,"parameters":[52,0,0,1]},{"code":0,"indent":1,"parameters":[]},{"code":412,"indent":0,"parameters":[]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":0,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true}],"x":5,"y":8},

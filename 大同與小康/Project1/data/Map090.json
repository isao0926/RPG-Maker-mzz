{"id":5,"name":"質人","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"characterIndex":0,"characterName":"","direction":2,"pattern":0,"tileId":0},"list":[{"code":101,"indent":0,"parameters":["",6,0,2,"柏郢"]},{"code":401,"indent":0,"parameters":["你好，這裡是質府，我是這裡的質人，叫做柏郢。我的職位是負責管"]},{"code":401,"indent":0,"parameters":["理市場交易的公平性，任何物品的販賣都必須透過我的檢定。"]},{"code":401,"indent":0,"parameters":["如果你手裡有東西要賣的話，請來找我，"]},{"code":401,"indent":0,"parameters":["我一定會給您一個公道的價格販售的"]},{"code":101,"indent":0,"parameters":["",6,0,2,"柏郢"]},{"code":401,"indent":0,"parameters":["請問有什麼事情需要我幫忙嗎？"]},{"code":102,"indent":0,"parameters":[["我要賣東西","為什麼賣東西需要要找你檢定","沒事"],2,0,2,0]},{"code":402,"indent":0,"parameters":[0,"我要賣東西"]},{"code":101,"indent":1,"parameters":["",6,0,2,"柏郢"]},{"code":401,"indent":1,"parameters":["你要和誰做買賣呢？"]},{"code":101,"indent":1,"parameters":["",6,0,2,"柏郢"]},{"code":401,"indent":1,"parameters":["請和他一同前來我面前"]},{"code":111,"indent":1,"parameters":[4,2,0]},{"code":101,"indent":2,"parameters":["蛋蛋 頭像",0,0,2,"豬腳"]},{"code":401,"indent":2,"parameters":["跟他"]},{"code":101,"indent":2,"parameters":["",6,0,2,"柏郢"]},{"code":401,"indent":2,"parameters":["好的，你們要交易的物品是？"]},{"code":0,"indent":2,"parameters":[]},{"code":412,"indent":1,"parameters":[]},{"code":0,"indent":1,"parameters":[]},{"code":402,"indent":0,"parameters":[1,"為什麼賣東西需要要找你檢定"]},{"code":101,"indent":1,"parameters":["",6,0,2,"柏郢"]},{"code":401,"indent":1,"parameters":["看來你之前沒有做過大生意吧，我來給你講講這裡是幹什麼的。"]},{"code":101,"indent":1,"parameters":["",6,0,2,"柏郢"]},{"code":401,"indent":1,"parameters":["質人的設立，是為了維持交易秩序，並且讓市場中的重要交易納入"]},{"code":401,"indent":1,"parameters":["國家的管理。"]},{"code":101,"indent":1,"parameters":["",6,0,2,"柏郢"]},{"code":401,"indent":1,"parameters":["我們會對貨物進行評估、平定價格，讓買賣雙方有合理的價格依據，"]},{"code":401,"indent":1,"parameters":["避免買賣雙方任意抬價、壓價使得交易價格維持合理的標準，"]},{"code":401,"indent":1,"parameters":["並且買賣時我們會統一度量衡讓雙方用相同的衡量標準交易，"]},{"code":401,"indent":1,"parameters":["最後調整完交易細節後，需要立下質劑作為證明。"]},{"code":101,"indent":1,"parameters":["",6,0,2,"柏郢"]},{"code":401,"indent":1,"parameters":["若有人違反市場規定，就會受到處罰。若交易後發生糾紛，"]},{"code":401,"indent":1,"parameters":["我們也會處理質劑相關的訴訟，但必須在一年內提出。"]},{"code":101,"indent":1,"parameters":["",6,0,2,"柏郢"]},{"code":401,"indent":1,"parameters":["除此之外，人民、牛馬、兵器、珍異等交易也都在我們的管理範圍內"]},{"code":401,"indent":1,"parameters":["透過質劑，國家便能掌握這些重要交易與資源的流動"]},{"code":101,"indent":1,"parameters":["蛋蛋 頭像",0,0,2,"豬腳"]},{"code":401,"indent":1,"parameters":["原來如此"]},{"code":0,"indent":1,"parameters":[]},{"code":402,"indent":0,"parameters":[2,"沒事"]},{"code":0,"indent":1,"parameters":[]},{"code":404,"indent":0,"parameters":[]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":0,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true}],"x":9,"y":8},
